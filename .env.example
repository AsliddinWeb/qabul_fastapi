# ==========================================================
# Xalqaro Innovatsion Universiteti — Admission System
# Root environment (used by docker-compose)
# Domain: qabul.xiuedu.uz
# ==========================================================

# --- Public ports ---
HOST_HTTP_PORT=8031

# --- PostgreSQL ---
POSTGRES_DB=admission
POSTGRES_USER=admission
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# --- Backend (FastAPI) ---
APP_ENV=production
APP_DEBUG=false
APP_SECRET_KEY=change_me_to_a_long_random_string_min_32_chars
APP_TIMEZONE=Asia/Tashkent

# JSON list of allowed origins (use exact origins in prod, not "*")
# Example for multi-domain: ["https://qabul.xiuedu.uz","https://xiuedu.uz"]
CORS_ORIGINS=["https://qabul.xiuedu.uz"]

# Public base URL — used for QR codes, public links in PDFs/SMS
PUBLIC_BASE_URL=https://qabul.xiuedu.uz

# --- JWT ---
JWT_ALGORITHM=HS256
JWT_ACCESS_TTL_MIN=30
JWT_REFRESH_TTL_DAYS=14

# --- OTP ---
OTP_TTL_SECONDS=120
OTP_LENGTH=6
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5

# --- Eskiz SMS gateway ---
ESKIZ_BASE_URL=https://notify.eskiz.uz/api
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
ESKIZ_FROM=4546

# --- Files / media ---
MEDIA_ROOT=/app/media
MEDIA_URL=/media
MAX_UPLOAD_SIZE_MB=10

# --- Leads SLA worker (auto-reassign cold leads) ---
LEADS_SLA_HOURS=72
LEADS_SLA_POLL_SECONDS=3600

# --- University identity (used in contracts as "university" party) ---
UNIVERSITY_NAME=Xalqaro Innovatsion Universiteti
UNIVERSITY_LEGAL_ADDRESS=Qarshi shahri, I.Karimov ko'chasi 405-uy
UNIVERSITY_INN=
UNIVERSITY_DIRECTOR_NAME=Direktor F.I.Sh
UNIVERSITY_DIRECTOR_TITLE=Rektor

# --- Frontend (Vue SPA mounted at /app) ---
VITE_API_BASE_URL=/api/v1
VITE_APP_NAME=XIU Qabul

# --- Landing (Nuxt 3 SSR at /) ---
NUXT_PUBLIC_APP_URL=/app
NUXT_PUBLIC_API_BASE_URL=/api/v1
NUXT_PUBLIC_SITE_URL=https://qabul.xiuedu.uz
