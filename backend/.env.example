# Backend-only env (when running without docker-compose, e.g. local dev).
# In Docker mode, the root .env is used.

APP_ENV=development
APP_DEBUG=true
APP_SECRET_KEY=dev-secret-change-me-to-min-32-chars
APP_TIMEZONE=Asia/Tashkent

CORS_ORIGINS=["http://localhost:5173","http://localhost:8031"]
PUBLIC_BASE_URL=http://localhost:8031

DATABASE_URL=postgresql+asyncpg://admission:admission@localhost:5432/admission
REDIS_URL=redis://localhost:6379/0

JWT_ALGORITHM=HS256
JWT_ACCESS_TTL_MIN=30
JWT_REFRESH_TTL_DAYS=14

OTP_TTL_SECONDS=120
OTP_LENGTH=6
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5

ESKIZ_BASE_URL=https://notify.eskiz.uz/api
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
ESKIZ_FROM=4546

MEDIA_ROOT=./media
MEDIA_URL=/media
MAX_UPLOAD_SIZE_MB=10

LEADS_SLA_HOURS=72
LEADS_SLA_POLL_SECONDS=3600

UNIVERSITY_NAME=Xalqaro Innovatsion Universiteti
UNIVERSITY_LEGAL_ADDRESS=Qarshi shahri, I.Karimov ko'chasi 405-uy
UNIVERSITY_INN=
UNIVERSITY_DIRECTOR_NAME=Direktor F.I.Sh
UNIVERSITY_DIRECTOR_TITLE=Rektor
