# --- Telegram ---
# From @BotFather
BOT_TOKEN=123456:ABC-DEF...
# Group chat id (negative for groups/supergroups). Add the bot to the group,
# then send /id in the group to get this value.
GROUP_CHAT_ID=-1001234567890

# --- Backend API ---
API_BASE_URL=https://qabul.xiuedu.uz/api/v1
# Dedicated ADMIN service account (NOT an operator — operators are data-scoped).
SERVICE_PHONE=+998900000000
SERVICE_PASSWORD=change-me

# --- Ingest (backend → bot push) ---
# Must match the backend's NOTIFY_BOT_SECRET.
INGEST_SECRET=generate-a-long-random-string
INGEST_HOST=0.0.0.0
INGEST_PORT=8090

REQUEST_TIMEOUT=10
